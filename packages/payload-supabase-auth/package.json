{
  "name": "@dombestein-data/payload-supabase-auth",
  "version": "0.0.0",
  "description": "Supabase Auth integration for Payload CMS.",
  "type": "module",
  "license": "MIT",
  "author": "Dombestein Data",
  "homepage": "https://github.com/dombestein-data/payload-supabase-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dombestein-data/payload-supabase-auth.git",
    "directory": "packages/payload-supabase-auth"
  },
  "bugs": {
    "url": "https://github.com/dombestein-data/payload-supabase-auth/issues"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "supabase",
    "authentication",
    "jwt"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "payload": "^3.86.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "payload": "3.86.0",
    "react": "19.2.6",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
